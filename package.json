{
  "name": "modelvisio",
  "version": "1.2.0",
  "private": true,
  "description": "Neural-network model analyzer for edge deployment, for the web, desktop and VS Code.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @modelvisio/web dev",
    "build": "pnpm --filter @modelvisio/web build",
    "preview": "pnpm --filter @modelvisio/web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build:vscode": "pnpm --filter modelvisio-vscode build",
    "package:vscode": "pnpm --filter modelvisio-vscode package",
    "release:desktop": "node scripts/release-desktop.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@modelvisio/ai": "workspace:*"
  },
  "packageManager": "pnpm@10.29.3"
}
